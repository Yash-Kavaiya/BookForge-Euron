# --- Gemini credentials (choose ONE) ---------------------------------------
# Option A: Google AI Studio key (simplest for local dev)
GOOGLE_API_KEY=your-key-here

# Option B: Vertex AI (production / GCP)
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-gcp-project
# GOOGLE_CLOUD_LOCATION=us-central1

# --- LLM routing, one model per stage (all optional) ------------------------
# Strong model where prose quality matters (writer/refiner), fast model for
# extraction (analyst) and judgement (critic). REFINER_MODEL empty = WRITER_MODEL.
BOOKFORGE_ANALYST_MODEL=gemini-2.5-flash
BOOKFORGE_WRITER_MODEL=gemini-2.5-pro
BOOKFORGE_CRITIC_MODEL=gemini-2.5-flash
# BOOKFORGE_REFINER_MODEL=
BOOKFORGE_ANALYST_TEMPERATURE=0.1
BOOKFORGE_WRITER_TEMPERATURE=0.3
BOOKFORGE_CRITIC_TEMPERATURE=0.0
BOOKFORGE_LLM_MAX_OUTPUT_TOKENS=16384

# --- Optional: OpenAI-compatible endpoint (e.g. NVIDIA NIM) ------------------
# When base URL + key are set and models don't start with "gemini-",
# they route through the custom endpoint instead of Gemini.
# BOOKFORGE_OPENAI_API_BASE=https://integrate.api.nvidia.com/v1
# BOOKFORGE_OPENAI_API_KEY=nvapi-your-key-here

# --- Media pipeline ----------------------------------------------------------
BOOKFORGE_FRAME_INTERVAL_SEC=5
BOOKFORGE_FRAME_PHASH_THRESHOLD=6
BOOKFORGE_MAX_FRAMES_PER_CHAPTER=12
# BOOKFORGE_MAX_VIDEOS=            # empty = whole channel
BOOKFORGE_DOWNLOAD_RESOLUTION=480
BOOKFORGE_WHISPER_MODEL=base

# --- Quality gate ------------------------------------------------------------
BOOKFORGE_QA_MAX_ITERATIONS=3
# once   = LLM critic reviews the chapter the first time machine checks pass (default)
# always = every machine pass is also LLM-reviewed
# never  = deterministic checks + pdflatex alone decide (fastest)
BOOKFORGE_QA_LLM_CRITIC_MODE=once
# true = a number in the prose that is in neither analysis nor transcript blocks the chapter
BOOKFORGE_QA_STRICT_NUMBERS=true
BOOKFORGE_COMPILE_LATEX=true

# --- Speed -------------------------------------------------------------------
BOOKFORGE_MEDIA_PREFETCH_CONCURRENCY=3   # upcoming videos downloaded/transcribed in parallel
BOOKFORGE_FRAME_HASH_WORKERS=4           # threads scoring/hashing frames during dedupe
BOOKFORGE_ASSET_RENDER_WORKERS=4         # threads rendering charts/tables per chapter
BOOKFORGE_REUSE_CACHED_ANALYSIS=true     # chapters/<NN>/analysis.json reused when transcript+model+prompt unchanged
BOOKFORGE_REUSE_WRITTEN_CHAPTERS=true    # 'written' chapters resume in the QA loop instead of being rewritten

# --- Housekeeping ------------------------------------------------------------
BOOKFORGE_WORKSPACE_ROOT=data
BOOKFORGE_LOG_LEVEL=INFO

# --- MLflow tracing (official Google ADK OTLP spec) -------------------------
# Start with ./start_all.sh or start_all.ps1 so these are exported BEFORE adk web.
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
MLFLOW_EXPERIMENT_NAME=my-experiment
# BOOKFORGE_DISABLE_MLFLOW_TRACING=1
# When tracing is on, per-chapter and per-run timing/token metrics are also
# logged as MLflow runs (chapter.* / run.* metrics) for before/after comparison.

# --- Langfuse tracing (optional, OpenTelemetry) ------------------------------
# BOOKFORGE_LANGFUSE_ENABLED=true
# BOOKFORGE_LANGFUSE_PUBLIC_KEY=pk-lf-...
# BOOKFORGE_LANGFUSE_SECRET_KEY=sk-lf-...
# BOOKFORGE_LANGFUSE_HOST=https://cloud.langfuse.com
