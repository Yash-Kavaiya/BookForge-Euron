# =============================================================================
# BookForge on Euron: copy to .env and fill in. Never commit real values.
# =============================================================================

# --- Euron EURI API (required) ----------------------------------------------
# Create a key at https://euron.one/euri . Used by both the web app and the
# ADK YouTube pipeline. OpenAI-compatible, sent as a Bearer token.
EURI_API_KEY=your-euri-api-key
# BOOKFORGE_EURI_API_BASE=https://api.euron.one/api/v1/euri
# EURI allows 2 concurrent requests per account.
BOOKFORGE_LLM_MAX_CONCURRENCY=2

# --- Web app (bookforge/web, deployed on Vercel) ----------------------------
# Euron-hosted euri-* models are unlimited on Euron Plus; outside models
# (gpt-*, gemini-*, claude-*) share a daily token cap.
BOOKFORGE_WEB_PLANNER_MODEL=euri-chat-fast
BOOKFORGE_WEB_WRITER_MODEL=euri-chat-fast
BOOKFORGE_WEB_DEEP_WRITER_MODEL=euri-chat-smart
BOOKFORGE_WEB_CRITIC_MODEL=euri-chat-fast
BOOKFORGE_WEB_IMAGE_MODEL=euri-image-fast
# Seconds after which optional review steps are skipped and unfinished
# chapters are cut, so a book always ships inside the function limit (300 s).
BOOKFORGE_WEB_TIME_BUDGET=270
BOOKFORGE_WEB_REQUEST_TIMEOUT=120
BOOKFORGE_WEB_MAX_JOBS=3
BOOKFORGE_WEB_OUTPUT_DIR=/tmp/bookforge
# Optional: require this code on /api/generate so strangers can't spend your quota.
# BOOKFORGE_ACCESS_CODE=

# --- ADK YouTube pipeline: one model per stage (all optional) ---------------
BOOKFORGE_ANALYST_MODEL=euri-chat-fast
BOOKFORGE_WRITER_MODEL=euri-chat-smart
BOOKFORGE_CRITIC_MODEL=euri-chat-fast
# BOOKFORGE_REFINER_MODEL=            # empty = same as WRITER_MODEL
BOOKFORGE_ANALYST_TEMPERATURE=0.1
BOOKFORGE_WRITER_TEMPERATURE=0.3
BOOKFORGE_CRITIC_TEMPERATURE=0.0
BOOKFORGE_LLM_MAX_OUTPUT_TOKENS=8192

# --- Media pipeline ----------------------------------------------------------
BOOKFORGE_FRAME_INTERVAL_SEC=5
BOOKFORGE_FRAME_PHASH_THRESHOLD=6
BOOKFORGE_MAX_FRAMES_PER_CHAPTER=12
# BOOKFORGE_MAX_VIDEOS=            # empty = whole channel
BOOKFORGE_DOWNLOAD_RESOLUTION=480
BOOKFORGE_WHISPER_MODEL=base

# --- Quality gate ------------------------------------------------------------
BOOKFORGE_QA_MAX_ITERATIONS=3
# once / always / never: how often the LLM critic runs after a clean machine pass
BOOKFORGE_QA_LLM_CRITIC_MODE=once
BOOKFORGE_QA_STRICT_NUMBERS=true
BOOKFORGE_COMPILE_LATEX=true

# --- Speed -------------------------------------------------------------------
BOOKFORGE_MEDIA_PREFETCH_CONCURRENCY=3
BOOKFORGE_FRAME_HASH_WORKERS=4
BOOKFORGE_ASSET_RENDER_WORKERS=4
BOOKFORGE_REUSE_CACHED_ANALYSIS=true
BOOKFORGE_REUSE_WRITTEN_CHAPTERS=true

# --- Housekeeping ------------------------------------------------------------
BOOKFORGE_WORKSPACE_ROOT=data
BOOKFORGE_LOG_LEVEL=INFO

# --- Optional tracing (pip install ".[observability]") -----------------------
# MLFLOW_TRACKING_URI=http://127.0.0.1:5000
# MLFLOW_EXPERIMENT_NAME=bookforge
# BOOKFORGE_DISABLE_MLFLOW_TRACING=1
# BOOKFORGE_LANGFUSE_ENABLED=true
# BOOKFORGE_LANGFUSE_PUBLIC_KEY=
# BOOKFORGE_LANGFUSE_SECRET_KEY=
# BOOKFORGE_LANGFUSE_HOST=https://cloud.langfuse.com
